# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 Git 에 커밋되지 않습니다)
# cp .env.example .env

# 국토교통부 아파트 매매 실거래가 API (공공데이터포털 서비스키)
MOLIT_API_KEY=

# 한국은행 ECOS Open API 인증키
ECOS_API_KEY=

# (선택) 설정 파일 경로. 기본값: configs/settings.yaml
APARTMENT_ML_CONFIG=configs/settings.yaml
# 개발 프론트엔드 허용 출처 (쉼표 구분, .env 자동 로딩 안 함)
APARTMENT_ML_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
