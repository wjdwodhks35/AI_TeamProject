# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets — never commit real keys
.env
.env.*
!.env.example

# Data: raw/processed data are NOT committed (only .gitkeep). data/sample/ is committed.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Trained model artifacts
models/*
!models/.gitkeep

# Notebooks checkpoints
.ipynb_checkpoints/
